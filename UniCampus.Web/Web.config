<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    CADENA DE CONEXIÓN (sin secretos):
    Usa autenticación integrada de Windows, por lo que NO contiene usuario ni contraseña.
    Ajuste solo el nombre del servidor según su instalación:
      SQL Server Express : .\SQLEXPRESS
      SQL Server LocalDB : (localdb)\MSSQLLocalDB
      SQL Server por defecto: .   (o localhost)
    Si usa autenticación SQL, NO escriba la clave aquí: use un archivo Web.Local.config (ignorado por Git).
  -->
  <connectionStrings>
    <add name="UniCampusDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=UniCampusDB;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=15"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" requestValidationMode="4.5" maxRequestLength="4096" />
    <pages controlRenderingCompatibilityVersion="4.0" validateRequest="true" />
    <!-- En producción cambie a RemoteOnly/On para no mostrar errores técnicos al usuario -->
    <customErrors mode="RemoteOnly" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Actividades.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
